# ------------------------------------------------------------------
# Cross-Border Payment Compliance Guard — Backend Environment Config
# Copy this file to `.env` and fill in real values.
# The app runs in full DEMO MODE with none of these set.
# ------------------------------------------------------------------

# Database
# Leave unset to fall back to a local SQLite file (./compliance_guard.db)
DATABASE_URL=sqlite:///./compliance_guard.db
# Example for Postgres:
# DATABASE_URL=postgresql://user:password@localhost:5432/compliance_guard

# Auth
JWT_SECRET_KEY=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=120

# Razorpay Test Mode credentials
# Get these from Dashboard -> Account & Settings -> API Keys (Test Mode)
# If left blank, the app automatically uses realistic MOCK Razorpay data.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# LLM API key (Anthropic)
# If left blank, the app uses deterministic template-based "Demo AI" explanations
# so the product is always fully demoable without any API key.
LLM_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# CORS - frontend origin
FRONTEND_ORIGIN=http://localhost:5173
